# Copy to .env.local for local development. Never commit .env.local.

# Optional. Public URL of the site, used for canonical URLs, Open Graph, sitemap and robots.
# Leave unset until you have a custom domain: on Vercel the production URL is used
# automatically, and locally http://localhost:3000 is used.
# NEXT_PUBLIC_SITE_URL=https://your-final-domain.com
